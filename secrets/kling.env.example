# 复制本文件为 secrets/kling.env 并填入真实值。
# secrets/ 已被 .gitignore 忽略，不会进入版本库。
# 注意：填好后不要把内容贴进任何聊天窗口。

# 你的 API Key（形如 api-key-kling-xxxxxxxx）
KLING_API_KEY=在这里填完整的 API Key

# 你在哪个平台开通的：控制台域名，或文档里写的接口基地址
# 例：https://api.xxx.com/kling  或  https://xxx.com/v1
KLING_BASE_URL=在这里填基地址

# 可选：文档地址，方便我查参数格式
KLING_DOC_URL=
